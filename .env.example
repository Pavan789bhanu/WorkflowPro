# WorkflowPro environment configuration
# Copy to `.env` and fill in real values. NEVER commit your real .env.

# ============================================
# SECURITY
# ============================================
# JWT signing key — REQUIRED in production. Generate with: openssl rand -hex 32
SECRET_KEY=

# ============================================
# LLM PROVIDER — set at least ONE API key
# ============================================
# Which provider to use: auto | openai | anthropic
LLM_PROVIDER=auto

# OpenAI (GPT-4o — vision-capable, used by the agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude (optional alternative; vision-capable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ============================================
# APPLICATION
# ============================================
# ENVIRONMENT: development | production | test
ENVIRONMENT=development
DEBUG=true
RATE_LIMIT_PER_MINUTE=60

# Agent tuning
AGENT_MAX_STEPS=25                 # hard cap on actions per run (cost guard)
AGENT_MAX_CONSECUTIVE_FAILURES=5   # end the run early if stuck (cost guard)
DEFAULT_HEADLESS=true              # false = watch the browser locally (dev only)
TIMEOUT=10000                      # default Playwright timeout (ms)

# ============================================
# DEFAULT ADMIN (created by init_db.py)
# ============================================
# Change these before any non-local deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# ============================================
# DATABASE (optional — defaults to local SQLite)
# ============================================
# DATABASE_URL=sqlite:///./backend/ui_capture.db
# For production use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/workflowpro

# ============================================
# PATHS (defaults are fine locally; Docker overrides these)
# ============================================
# SCREENSHOT_DIR=./backend/captured_dataset
# USER_DATA_DIR=./browser_session_data
# STORAGE_STATE_PATH=./storage_state.json
